{
  "name": "@gravity-ui/markdown-viewer",
  "version": "0.0.0",
  "description": "React viewer for prepared HTML with composable extensions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/markdown-editor"
  },
  "keywords": [
    "md",
    "yfm",
    "markdown"
  ],
  "scripts": {
    "clean": "gulp clean",
    "build": "gulp build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "run-p -cs lint:*",
    "lint:js": "eslint './**/*.{js,jsx,mjs,ts,tsx}'",
    "lint:styles": "stylelint './**/*.{css,scss}' --allow-empty-input",
    "lint:prettier": "prettier --check './**/*.{js,jsx,mjs,ts,tsx,css,scss}'",
    "test": "run-p --continue-on-error test:react18 test:react19 test:package",
    "prepublishOnly": "nx lint && nx clean && nx build",
    "test:react18": "VIEWER_REACT_VERSION=18 vitest run",
    "test:react19": "VIEWER_REACT_VERSION=19 vitest run",
    "test:package": "pnpm build && run-p --continue-on-error test:imports:* test:types:*",
    "test:imports:root": "node tests/package-imports/root.mjs",
    "test:imports:extensions": "node tests/package-imports/extensions.mjs",
    "test:types:react18": "tsc -p tests/types/tsconfig.json --noEmit",
    "test:types:react19": "tsc -p tests/types/tsconfig.react19.json --noEmit"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./extensions": {
      "import": {
        "types": "./build/esm/extensions.d.ts",
        "default": "./build/esm/extensions.js"
      },
      "require": {
        "types": "./build/cjs/extensions.d.ts",
        "default": "./build/cjs/extensions.js"
      }
    },
    "./styles.css": "./build/styles.css"
  },
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "files": [
    "build",
    "README.md"
  ],
  "dependencies": {
    "@bem-react/classname": "^1.6.0",
    "@gravity-ui/icons": "^2.12.0",
    "tslib": "catalog:ts"
  },
  "devDependencies": {
    "@gravity-ui/uikit": "catalog:peer-gravity",
    "@markdown-editor/gulp-tasks": "workspace:*",
    "@markdown-editor/linters": "workspace:*",
    "@markdown-editor/tsconfig": "workspace:*",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "gulp-cli": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:ts",
    "@markdown-editor/vitest-config": "workspace:*",
    "vitest": "catalog:testing",
    "jsdom": "25.0.1",
    "esbuild": "^0.28.2",
    "@markdown-viewer-tests/react19": "workspace:*"
  },
  "peerDependencies": {
    "@gravity-ui/uikit": "^7.34.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ]
}
