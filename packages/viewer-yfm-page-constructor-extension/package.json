{
  "name": "@gravity-ui/markdown-viewer-yfm-page-constructor-extension",
  "version": "0.0.0",
  "description": "Diplodoc Page Constructor extension for @gravity-ui/markdown-viewer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/markdown-editor"
  },
  "keywords": [
    "md",
    "yfm",
    "markdown",
    "page-constructor"
  ],
  "scripts": {
    "clean": "gulp clean",
    "build": "gulp build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm test:types",
    "lint": "run-p -cs lint:*",
    "lint:js": "eslint './**/*.{js,jsx,mjs,ts,tsx}'",
    "lint:styles": "stylelint './**/*.{css,scss}' --allow-empty-input",
    "lint:prettier": "prettier --check './**/*.{js,jsx,mjs,ts,tsx,css,scss}'",
    "test": "run-p --continue-on-error test:unit test:package",
    "prepublishOnly": "nx lint && nx clean && nx build",
    "test:package": "pnpm build && run-p test:imports test:package-types",
    "test:imports": "node --test \"tests/package-imports/*.mjs\"",
    "test:unit": "vitest run",
    "test:types": "tsc -p tests/types/tsconfig.json --noEmit",
    "test:package-types": "tsc -p tests/types/tsconfig.package.json --noEmit"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    }
  },
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "files": [
    "build",
    "README.md"
  ],
  "dependencies": {
    "react-error-boundary": "catalog:",
    "tslib": "catalog:ts"
  },
  "devDependencies": {
    "@diplodoc/page-constructor-extension": "catalog:peer-diplodoc",
    "@gravity-ui/markdown-viewer": "workspace:*",
    "@gravity-ui/page-constructor": "catalog:peer-gravity",
    "@gravity-ui/uikit": "catalog:peer-gravity",
    "@markdown-editor/gulp-tasks": "workspace:*",
    "@markdown-editor/linters": "workspace:*",
    "@markdown-editor/tsconfig": "workspace:*",
    "@markdown-editor/vitest-config": "workspace:*",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "esbuild": "catalog:",
    "gulp-cli": "catalog:",
    "jsdom": "catalog:testing",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:ts",
    "vitest": "catalog:testing"
  },
  "peerDependencies": {
    "@diplodoc/page-constructor-extension": "^0.13.3",
    "@gravity-ui/markdown-viewer": "^0.1.0",
    "@gravity-ui/page-constructor": "^7.21.0",
    "@gravity-ui/uikit": "^7.39.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "sideEffects": false
}
