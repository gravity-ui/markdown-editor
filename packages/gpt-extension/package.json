{
  "name": "@gravity-ui/markdown-editor-gpt-extension",
  "version": "0.1.0",
  "description": "GPT dialog and editor plugins for Markdown Editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/markdown-editor"
  },
  "keywords": [
    "md",
    "yfm",
    "wysiwyg",
    "markdown",
    "codemirror",
    "prosemirror"
  ],
  "scripts": {
    "clean": "gulp clean",
    "build": "gulp build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "run-p -cs lint:*",
    "lint:js": "eslint './**/*.{js,jsx,mjs,ts,tsx}'",
    "lint:styles": "stylelint \"./**/*.scss\" --allow-empty-input",
    "lint:prettier": "prettier --check './**/*.{js,jsx,mjs,ts,tsx,css,scss}'",
    "test": "vitest run",
    "prepublishOnly": "nx lint && nx clean && nx build"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./configure": {
      "import": {
        "types": "./build/esm/configure.d.ts",
        "default": "./build/esm/configure.js"
      },
      "require": {
        "types": "./build/cjs/configure.d.ts",
        "default": "./build/cjs/configure.js"
      }
    },
    "./*": {
      "import": {
        "types": "./build/esm/*.d.ts",
        "default": "./build/esm/*.js"
      },
      "require": {
        "types": "./build/cjs/*.d.ts",
        "default": "./build/cjs/*.js"
      }
    },
    "./styles/*": "./build/esm/*"
  },
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "files": [
    "build",
    "README.md"
  ],
  "dependencies": {
    "@bem-react/classname": "^1.6.0",
    "@gravity-ui/i18n": "^1.7.0",
    "@gravity-ui/icons": "^2.12.0",
    "lodash": "^4.17.21",
    "react-hotkeys-hook": "^4.5.0",
    "tslib": "catalog:ts"
  },
  "devDependencies": {
    "@gravity-ui/uikit": "catalog:peer-gravity",
    "@markdown-editor/gulp-tasks": "workspace:*",
    "@markdown-editor/tsconfig": "workspace:*",
    "@markdown-editor/vitest-config": "workspace:*",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@types/lodash": "^4.14.177",
    "gulp-cli": "catalog:",
    "npm-run-all": "^4.1.5",
    "typescript": "catalog:ts",
    "vitest": "catalog:testing",
    "jsdom": "25.0.1",
    "@testing-library/react": "16.3.0",
    "@codemirror/state": "^6.5.1",
    "@codemirror/view": "^6.36.2",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.38.0"
  },
  "peerDependencies": {
    "@gravity-ui/uikit": "^7.1.0",
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "@codemirror/state": "^6.5.1",
    "@codemirror/view": "^6.36.2",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.38.0"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ]
}
