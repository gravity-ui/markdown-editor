{
  "name": "@gravity-ui/markdown-viewer-yfm-latex-extension",
  "version": "0.1.0",
  "description": "Diplodoc LaTeX extension for @gravity-ui/markdown-viewer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/markdown-editor"
  },
  "keywords": [
    "md",
    "yfm",
    "markdown",
    "latex"
  ],
  "scripts": {
    "clean": "gulp clean",
    "build": "gulp build",
    "typecheck": "tsc -p tsconfig.json --noEmit && run-p test:types:*",
    "lint": "run-p -cs lint:*",
    "lint:js": "eslint './**/*.{js,jsx,mjs,ts,tsx}'",
    "lint:styles": "stylelint './**/*.{css,scss}' --allow-empty-input",
    "lint:prettier": "prettier --check './**/*.{js,jsx,mjs,ts,tsx,css,scss}'",
    "test": "run-p --continue-on-error test:latex1 test:latex2 test:package",
    "prepublishOnly": "nx lint && nx clean && nx build",
    "test:latex1": "LATEX_VERSION=1 vitest run",
    "test:latex2": "LATEX_VERSION=2 vitest run",
    "test:package": "pnpm build && run-p test:imports test:package-types:*",
    "test:imports": "node --test \"tests/package-imports/*.mjs\"",
    "test:types:latex1": "tsc -p tests/types/tsconfig.latex1.json --noEmit",
    "test:types:latex2": "tsc -p tests/types/tsconfig.json --noEmit",
    "test:package-types:latex1": "tsc -p tests/types/tsconfig.package.latex1.json --noEmit",
    "test:package-types:latex2": "tsc -p tests/types/tsconfig.package.json --noEmit"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    }
  },
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "files": [
    "build",
    "README.md"
  ],
  "dependencies": {
    "@types/katex": "^0.16.7",
    "tslib": "catalog:ts"
  },
  "devDependencies": {
    "@diplodoc/latex-extension": "2.0.0",
    "@diplodoc/latex-extension-v1": "npm:@diplodoc/latex-extension@1.3.4",
    "@gravity-ui/markdown-viewer": "workspace:*",
    "@markdown-editor/gulp-tasks": "workspace:*",
    "@markdown-editor/linters": "workspace:*",
    "@markdown-editor/tsconfig": "workspace:*",
    "@markdown-editor/vitest-config": "workspace:*",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "gulp-cli": "catalog:",
    "jsdom": "catalog:testing",
    "katex": "catalog:peers",
    "markdown-it": "catalog:peers",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:ts",
    "vitest": "catalog:testing"
  },
  "peerDependencies": {
    "@diplodoc/latex-extension": "^1.3.4 || ^2.0.0",
    "@gravity-ui/markdown-viewer": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "sideEffects": false
}
